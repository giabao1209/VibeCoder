{
  "name": "vibereader",
  "version": "0.3.1",
  "description": "A colorful live Markdown and LaTeX reader with tabs, chapter navigation, and document themes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "author": "VibeCoder",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vibecoder.vibereader",
    "productName": "VibeReader",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer-v2.js",
      "latex-renderer.js",
      "index.html",
      "style.css",
      "latex.css",
      "themes.css",
      "icon-512.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
